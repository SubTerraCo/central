# Cara host only. Copy to .env on Cara. Do not commit .env.
# Names only — never put secret values in git, PRs, or logs.

# LAN Bearer for Rook/Central → this bridge. Distinct from ANYTYPE_API_KEY.
# Required whenever BRIDGE_LISTEN_HOST is not loopback (production LAN must set this).
BRIDGE_TOKEN=

# Anytype Local API bearer. Cara-local env only. Never sent on the LAN.
# Central remains the system of record for the credential; Cara holds a local copy for injection.
ANYTYPE_API_KEY=

# Cara → Anytype desktop (loopback). Prefer ANYTYPE_UPSTREAM on Cara.
# ANYTYPE_BASE is accepted as an alias. Default is the Anytype Local API origin.
ANYTYPE_UPSTREAM=http://127.0.0.1:31009
ANYTYPE_BASE=http://127.0.0.1:31009
ANYTYPE_VERSION=2025-11-08

# Bridge listen. Default is loopback so this process does not expose a LAN port without a token.
# For Rook/Central on the LAN: set BRIDGE_LISTEN_HOST to the Cara LAN address (or 0.0.0.0) AND set BRIDGE_TOKEN.
BRIDGE_LISTEN_HOST=127.0.0.1
BRIDGE_LISTEN_PORT=31010
