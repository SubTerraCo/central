# Central-side process only. Do not commit real values.
# Cara runs Anytype desktop Local API on 127.0.0.1:31009.

ANYTYPE_BASE=http://127.0.0.1:31009
ANYTYPE_API_KEY=
ANYTYPE_VERSION=2025-11-08
POWERLINE_SPACE_NAME=Powerline

# HTTP surface Central hosts (not the Anytype port).
ANYTYPE_HTTP_HOST=127.0.0.1
ANYTYPE_HTTP_PORT=32109

# Inbound Bearer for Central routes. Distinct from ANYTYPE_API_KEY.
# Required if this process is reachable beyond localhost.
BRIDGE_TOKEN=
