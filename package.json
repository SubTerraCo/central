{
  "name": "central",
  "private": true,
  "version": "0.1.0",
  "description": "Central monorepo. Standalone packages inside two shells.",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @central/central dev",
    "dev:web": "pnpm --filter @central/metro dev",
    "dev:anytype-bridge": "pnpm --filter @central/anytype-bridge start",
    "build": "pnpm --filter @central/central build && pnpm --filter @central/metro build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
